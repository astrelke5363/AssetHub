<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    <clear /> drops any feed inherited from a machine- or user-level NuGet.config. Without it
    this solution picks up whatever private feeds happen to be configured on the developer's
    box, which restores fine locally and fails in CI. Everything here comes from nuget.org.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
